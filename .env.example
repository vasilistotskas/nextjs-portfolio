# ------------------------------------------------
# Site
# ------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ------------------------------------------------
# Contact form (https://resend.com)
# ------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=you@example.com

# ------------------------------------------------
# Spotify (https://developer.spotify.com/dashboard)
# ------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Fallback only. The live token lives in the Vercel Blob store so it can be
# replaced without a redeploy; this is read when no store is bound.
SPOTIFY_REFRESH_TOKEN=

# Gate for /api/spotify/reauth, which re-grants consent every six months.
# Any long random string: `openssl rand -hex 32`.
SPOTIFY_REAUTH_SECRET=

# ------------------------------------------------
# Vercel Blob — holds the Spotify refresh token at runtime
# ------------------------------------------------
# Added automatically when you create a *private* Blob store in the Vercel
# dashboard and link it to the project. On Vercel, OIDC covers this and the
# variable is only needed for local development.
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------
# GitHub (optional — raises API rate limit from 60 to 5000 req/hr)
# https://github.com/settings/tokens — needs no scopes for public data
# ------------------------------------------------
GITHUB_TOKEN=
