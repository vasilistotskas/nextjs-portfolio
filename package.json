{
	"name": "nextjs-portfolio",
	"version": "1.43.2",
	"private": false,
	"repository": "https://github.com/vasilistotskas/nextjs-portfolio.git",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/vasilistotskas/nextjs-portfolio/issues"
	},
	"homepage": "https://github.com/vasilistotskas/nextjs-portfolio#readme",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"build": "pnpm run clean && next build",
		"check:wgsl": "vgpu check components/ui/hero-field.wgsl",
		"clean": "rm -rf .next build .vercel",
		"dev": "next dev --turbopack",
		"format": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
		"format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"spotify:token": "node scripts/spotify-refresh-token.mjs",
		"start": "next start",
		"type-check": "next typegen && tsc --noEmit"
	},
	"release": {
		"branches": [
			"master"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/changelog",
			[
				"@semantic-release/npm",
				{
					"npmPublish": false
				}
			],
			[
				"@semantic-release/git",
				{
					"assets": [
						"CHANGELOG.md",
						"package.json"
					],
					"message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
				}
			],
			"@semantic-release/github"
		]
	},
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"clsx": "^2.1.1",
		"lucide-react": "^1.39.0",
		"motion": "^13.1.1",
		"next": "^16.3.4",
		"next-intl": "^4.14.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.87.0",
		"resend": "^6.25.0",
		"sharp": "^0.35.4",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"vgpu": "^0.3.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.4",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"semantic-release": "^25.0.9",
		"typescript": "^6.0.3"
	}
}
