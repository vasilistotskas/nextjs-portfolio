{
	"name": "nextjs-portfolio",
	"version": "1.52.0",
	"private": false,
	"type": "module",
	"repository": "https://github.com/vasilistotskas/nextjs-portfolio.git",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/vasilistotskas/nextjs-portfolio/issues"
	},
	"homepage": "https://github.com/vasilistotskas/nextjs-portfolio#readme",
	"engines": {
		"node": "24.x",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"build": "pnpm run clean && next build",
		"check:wgsl": "vgpu check components/ui/hero-field.wgsl",
		"clean": "rm -rf .next build .vercel",
		"dev": "next dev --turbopack",
		"format": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
		"format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"screenshots": "node scripts/screenshots.mjs",
		"spotify:token": "node scripts/spotify-refresh-token.mjs",
		"start": "next start",
		"type-check": "next typegen && tsc --noEmit"
	},
	"release": {
		"branches": [
			"master"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/changelog",
			[
				"@semantic-release/npm",
				{
					"npmPublish": false
				}
			],
			[
				"@semantic-release/git",
				{
					"assets": [
						"CHANGELOG.md",
						"package.json"
					],
					"message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
				}
			],
			"@semantic-release/github"
		]
	},
	"dependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"@vercel/blob": "^2.8.2",
		"@vercel/speed-insights": "^2.0.0",
		"lucide-react": "^1.59.0",
		"next": "^16.4.2",
		"next-intl": "^4.14.9",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"resend": "^6.34.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"vgpu": "^0.6.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.13.0",
		"eslint-config-next": "^16.4.2",
		"playwright-core": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"semantic-release": "^25.0.9",
		"typescript": "^6.0.3"
	}
}
