{
	"name": "nextjs-portfolio",
	"version": "1.39.1",
	"private": false,
	"repository": "https://github.com/vasilistotskas/nextjs-portfolio.git",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/vasilistotskas/nextjs-portfolio/issues"
	},
	"homepage": "https://github.com/vasilistotskas/nextjs-portfolio#readme",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"build": "pnpm run clean && next build",
		"clean": "rm -rf .next build .vercel",
		"dev": "next dev --turbopack",
		"format": "prettier --check --ignore-path .gitignore .",
		"format:fix": "prettier --write --ignore-path .gitignore .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"start": "next start",
		"type-check": "tsc --noEmit"
	},
	"release": {
		"branches": [
			"master"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/changelog",
			[
				"@semantic-release/npm",
				{
					"npmPublish": false
				}
			],
			[
				"@semantic-release/git",
				{
					"assets": [
						"CHANGELOG.md",
						"package.json"
					],
					"message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
				}
			],
			"@semantic-release/github"
		]
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"clsx": "^2.1.1",
		"lucide-react": "^1.26.0",
		"motion": "^12.42.2",
		"next": "^16.2.11",
		"next-intl": "^4.13.4",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.83.0",
		"resend": "^6.18.0",
		"sharp": "^0.35.3",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.6",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.2.11",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"semantic-release": "^25.0.8",
		"typescript": "^6.0.3"
	}
}
